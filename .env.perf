# Performance optimized environment variables
# Copy this to .env and modify as needed

# Database (use PgBouncer for connection pooling)
DATABASE_URL=postgres://postgres:postgres@localhost:6432/postgres?sslmode=disable
PGBOUNCER_URL=postgres://postgres:postgres@localhost:6432/postgres?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=8080

# Super admin
SUPER_ADMIN_EMAIL=super@hms.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@hms.local
EMAIL_FROM_NAME=HMS Platform

# App URL
APP_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=