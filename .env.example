# Base DSN pointing at the Postgres server. The app creates hms_registry
# and hms_<tenant> databases underneath this server at startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres?sslmode=disable
JWT_SECRET=change-me-super-secret
PORT=8080

# Default super-admin credentials created on first startup.
SUPER_ADMIN_EMAIL=super@hms.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!

# Email (SendGrid). Leave SENDGRID_API_KEY empty to fall back to a log sender
# that prints emails to stdout instead of calling SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@hms.local
EMAIL_FROM_NAME=HMS Platform
APP_URL=http://localhost:5173

# Image hosting (Cloudinary). Needed only if clients upload images through the
# signed upload endpoint.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
